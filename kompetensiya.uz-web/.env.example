# Bu faylni `.env` nomi bilan nusxalab, qiymatlarni to'ldiring.
# `.env` git'ga tushmaydi (.gitignore da).

# ── ONE ID (sso.egov.uz) ────────────────────────────────────────────────────
ONE_ID_URL=https://sso.egov.uz/sso/oauth/Authorization.do
# ONE ID kabinetida berilgan foydalanuvchi nomi (username)
ONE_ID_CLIENT_ID=
ONE_ID_CLIENT_SECRET=
ONE_ID_SCOPE=
# ONE ID kabinetida ro'yxatdan o'tkazilgan callback manzili.
# Bo'sh qoldirilsa, joriy so'rov manzilidan avtomatik hisoblanadi.
ONE_ID_REDIRECT_URL=
# Belgilangan state. Bo'sh qoldirilsa tasodifiy yaratiladi (xavfsizroq).
ONE_ID_STATE=

# ── Django ──────────────────────────────────────────────────────────────────
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=
# HTTPS majburiyati: DEBUG=0 da standart 1. Sertifikat tayyor bo'lmasa 0 qo'ying.
DJANGO_SECURE_SSL=
